{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@artchew/data-access-articles": [
        "libs/data-access-articles/src/index.ts"
      ],
      "@artchew/data-access-lessions": [
        "libs/data-access-lessions/src/index.ts"
      ],
      "@artchew/data-access-lessions/server": [
        "libs/data-access-lessions/src/server.ts"
      ],
      "@artchew/data-access-students": [
        "libs/data-access-students/src/index.ts"
      ],
      "@artchew/data-access-users": ["libs/data-access-users/src/index.ts"],
      "@artchew/util-axios": ["libs/util-axios/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
